{
  "name": "@ubrisus/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/cli-migrate.ts",
    "db:seed": "tsx src/db/cli-seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "adm-zip": "^0.5.16",
    "bwip-js": "^4.5.1",
    "docx": "^9.1.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "iconv-lite": "^0.6.3",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.16",
    "pdfmake": "^0.2.15",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfmake": "^0.2.11",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
