# Copie para .env e ajuste. Em produção, defina todas as chaves e senhas fortes.

# Banco de dados (aplicação e atualização do esquema)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ubrisus
DATABASE_URL_MIGRADOR=postgres://postgres:postgres@localhost:5432/ubrisus

# Senha do usuário "admin" criada na carga inicial (npm run setup)
ADMIN_SENHA_INICIAL=Admin@2026forte

# Segredos (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# COOKIE_SECRET=
# CHAVE_CRIPTOGRAFIA=

# Identificação da contratante
NOME_ENTIDADE=Prefeitura Municipal de Cabreúva
NOME_SECRETARIA=Secretaria Municipal de Saúde
IBGE_MUNICIPIO=3508405
UF_MUNICIPIO=SP
APP_URL=http://localhost:5173

# E-mail (vazio = mensagens apenas registradas no log)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=nao-responda@saude.cabreuva.sp.gov.br

# SMS (log = simulado; ou URL do gateway HTTP contratado)
SMS_PROVIDER=log
# SMS_URL=
# SMS_TOKEN=
